#!/usr/bin/env bash
# Run / build MyTermi.
#
#   ./run [dev|prod|build] [ios|android|windows] [extra flutter args...]
#
#   dev    debug build with hot reload            (default)
#   prod   release build, run on a device
#   build  release package: android -> APK, ios -> IPA, windows -> zip
#
# Platform defaults: macOS -> ios, Linux/Windows -> android.
# Examples:
#   ./run                      # dev on default platform
#   ./run prod android
#   ./run build ios
#   ./run build android --split-per-abi
#   ./run dev android -d emulator-5554   # pick a specific device
set -eo pipefail
cd "$(dirname "$0")"

usage() { sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

mode=dev
case "$(uname -s)" in Darwin) platform=ios ;; *) platform=android ;; esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    dev|prod|build) mode=$1 ;;
    ios|android|windows) platform=$1 ;;
    -h|--help|help) usage ;;
    *) break ;;   # rest goes to flutter
  esac
  shift
done
extra=("$@")

# --- locate flutter / android sdk -------------------------------------------
# Project pins its Flutter version in .fvmrc; use it via FVM when available.
if [[ -f .fvmrc ]] && command -v fvm >/dev/null 2>&1; then
  fvm_ver=$(sed -n 's/.*"flutter"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' .fvmrc | head -1)
  fvm_sdk="${FVM_CACHE_PATH:-$HOME/fvm}/versions/$fvm_ver"
  if [[ -x .fvm/flutter_sdk/bin/flutter ]]; then
    fvm_sdk="$PWD/.fvm/flutter_sdk"
  elif [[ ! -x $fvm_sdk/bin/flutter ]]; then
    echo "… Installing Flutter $fvm_ver via FVM (first run)"
    fvm install "$fvm_ver"
  fi
  if [[ -x $fvm_sdk/bin/flutter ]]; then
    export PATH="$fvm_sdk/bin:$PATH"
  else
    echo "✗ FVM Flutter $fvm_ver not found at $fvm_sdk" >&2; exit 1
  fi
fi
if ! command -v flutter >/dev/null 2>&1; then
  for d in "${FLUTTER_ROOT:-}" "$HOME/sdk/flutter" "$HOME/flutter" "$HOME/development/flutter"; do
    if [[ -n "$d" && -x "$d/bin/flutter" ]]; then export PATH="$d/bin:$PATH"; break; fi
  done
fi
command -v flutter >/dev/null 2>&1 || { echo "✗ flutter not found (add it to PATH or set FLUTTER_ROOT)." >&2; exit 1; }
if [[ -z "${ANDROID_HOME:-}" && -d "$HOME/sdk/android" ]]; then export ANDROID_HOME="$HOME/sdk/android"; fi

if [[ $platform == ios && "$(uname -s)" != Darwin ]]; then
  echo "✗ iOS can only be run/built on macOS (requires Xcode)." >&2; exit 1
fi
if [[ $platform == windows ]]; then
  case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*) ;;
    *) echo "✗ The Windows app can only be run/built on Windows (use run.cmd, requires Visual Studio C++)." >&2; exit 1 ;;
  esac
fi

defines=(--dart-define=APP_ENV="$([[ $mode == dev ]] && echo dev || echo prod)")
# Optional: sync server and Google Sign-In client IDs (see docs/apple-review.md).
[[ -n ${MYTERMI_API_URL:-} ]] && defines+=(--dart-define=API_URL="$MYTERMI_API_URL")
[[ -n ${GOOGLE_IOS_CLIENT_ID:-} ]] && defines+=(--dart-define=GOOGLE_IOS_CLIENT_ID="$GOOGLE_IOS_CLIENT_ID")
[[ -n ${GOOGLE_SERVER_CLIENT_ID:-} ]] && defines+=(--dart-define=GOOGLE_SERVER_CLIENT_ID="$GOOGLE_SERVER_CLIENT_ID")

# --- build --------------------------------------------------------------------
if [[ $mode == build ]]; then
  if [[ $platform == windows ]]; then
    set -x; flutter build windows --release "${defines[@]}" "${extra[@]}"; { set +x; } 2>/dev/null
    rel=build/windows/x64/runner/Release
    powershell -NoProfile -Command "Compress-Archive -Force -Path $rel/* -DestinationPath build/windows/MyTermi-windows-x64.zip"
    echo "✓ App: $rel/mytermi.exe"
    echo "✓ Zip: build/windows/MyTermi-windows-x64.zip (unzip, then run mytermi.exe)"
  elif [[ $platform == android ]]; then
    set -x; flutter build apk --release "${defines[@]}" "${extra[@]}"; { set +x; } 2>/dev/null
    echo "✓ APK: build/app/outputs/flutter-apk/"
  else
    set -x; flutter build ipa --release "${defines[@]}" "${extra[@]}"; { set +x; } 2>/dev/null
    echo "✓ IPA: build/ios/ipa/  (archive: build/ios/archive/Runner.xcarchive)"
  fi
  exit 0
fi

# --- run: pick a device for the platform unless -d was given ---------------------
has_device_arg=false
for a in "${extra[@]}"; do [[ $a == -d || $a == --device-id* ]] && has_device_arg=true; done

# Prints "id<TAB>emu|real<TAB>name" for each connected device of $platform.
# Fields are collected per device object (key order varies between devices).
# $1 = extra seconds to wait for slow (USB / wireless) iOS devices.
list_devices() {
  local timeout=()
  [[ -n ${1:-} ]] && timeout=(--device-timeout "$1")
  flutter devices --machine "${timeout[@]}" 2>/dev/null | awk -v want="$platform" '
    /^  \{/             { n=""; i=""; p=""; e="real" }
    /"name":/ && !n     { n=$0; sub(/.*"name": *"/,"",n); sub(/".*/,"",n) }
    /"id":/             { i=$0; sub(/.*"id": *"/,"",i);   sub(/".*/,"",i) }
    /"targetPlatform":/ { p=$0; sub(/.*"targetPlatform": *"/,"",p); sub(/".*/,"",p) }
    /"emulator": *true/ { e="emu" }
    /^  \}/             { if (index(p, want) == 1) printf "%s\t%s\t%s\n", i, e, n }'
}

has_real() { awk -F'\t' '$2=="real"' <<<"$1" | grep -q .; }

if [[ $platform == windows ]] && ! $has_device_arg; then
  extra=(-d windows "${extra[@]}")
  has_device_arg=true
fi

if ! $has_device_arg; then
  devices=$(list_devices)
  if [[ $platform == ios && $mode == prod ]] && ! has_real "$devices"; then
    echo "… Looking for a physical iPhone/iPad (cable or Wi-Fi)…"
    more=$(list_devices 10)
    [[ -n $more ]] && devices=$more
  fi
  if [[ -z $devices && $platform == ios ]]; then
    echo "… No iOS device found, opening Simulator"
    open -a Simulator || true
    for _ in $(seq 1 30); do sleep 2; devices=$(list_devices); [[ -n $devices ]] && break; done
  fi
  if [[ -z $devices ]]; then
    echo "✗ No connected $platform device found." >&2
    if [[ $platform == android ]]; then
      echo "  Plug in a phone (with USB debugging on) or start an emulator: flutter emulators --launch <id>" >&2
    else
      echo "  Connect an iPhone via cable/Wi-Fi (with Developer Mode on) or open Simulator." >&2
    fi
    exit 1
  fi
  # Prefer a real device; release mode can't run on the iOS simulator.
  pick=$(printf '%s\n' "$devices" | awk -F'\t' '$2=="real"' | head -1)
  if [[ -z $pick ]]; then
    if [[ $mode == prod && $platform == ios ]]; then
      cat >&2 <<'EOF'
✗ prod (release) mode can't run on the iOS Simulator and needs a physical iPhone, but Flutter doesn't see one.
  On the iPhone:
    1. Unlock the screen and tap "Trust" when asked after plugging in the cable.
    2. Turn on Developer Mode: Settings › Privacy & Security › Developer Mode, then restart the phone.
  On the Mac:
    3. Open Xcode › Window › Devices and Simulators and wait until the iPhone shows up and finishes preparing (the first time can take a few minutes).
    4. Run `flutter devices` (or `fvm flutter devices`) to check that the iPhone is listed.
  Devices Flutter currently sees:
EOF
      flutter devices 2>&1 | sed 's/^/    /' >&2
      exit 1
    fi
    pick=$(printf '%s\n' "$devices" | head -1)
  fi
  echo "→ Device: $(cut -f3 <<<"$pick") ($(cut -f1 <<<"$pick"))"
  extra=(-d "$(cut -f1 <<<"$pick")" "${extra[@]}")
fi

flags=(--debug); [[ $mode == prod ]] && flags=(--release)
set -x
exec flutter run "${flags[@]}" "${defines[@]}" "${extra[@]}"
